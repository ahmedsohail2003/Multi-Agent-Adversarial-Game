# Environment variables the program reads (via os.environ) at runtime.
# The program does not load .env files itself: export these in your shell,
# or copy this file to `.env` (which is gitignored) and use a tool that
# loads .env files, such as direnv.
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Optional: search depth in plies for minimax/alpha-beta on boards larger
# than 3x3; defaults to 4. Boards up to 3x3 are always searched exhaustively.
SEARCH_DEPTH_LIMIT=4
